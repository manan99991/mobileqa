[
 {
  "id": "TC01",
  "feature_id": "F1",
  "title": "Shield a GPS-tagged photo before sharing",
  "type": "happy",
  "entry_screen": "launch",
  "steps": [
   {
    "do": "tap",
    "target": "Build your own tool",
    "optional": true
   },
   {
    "do": "tap",
    "target": "Templates"
   },
   {
    "do": "tap",
    "target": "Run",
    "near": "Privacy share shield"
   },
   {
    "do": "tap",
    "target": "Choose photos"
   },
   {
    "do": "pick",
    "kind": "image"
   },
   {
    "do": "wait",
    "seconds": 8
   },
   {
    "do": "tap",
    "target": "Save or share"
   }
  ],
  "expected": "A new photo is produced with no GPS location, and Save or share opens the share sheet.",
  "checks": [
   {
    "oracle": "new_file",
    "arg": "image"
   },
   {
    "oracle": "exif_gps_removed"
   },
   {
    "oracle": "share_sheet_opened"
   },
   {
    "oracle": "no_app_error_logged"
   }
  ],
  "severity": "high"
 },
