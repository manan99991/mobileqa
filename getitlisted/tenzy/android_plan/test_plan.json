 {
  "id": "TC20",
  "feature_id": "F16",
  "title": "Summarise a long paragraph",
  "type": "happy",
  "entry_screen": "launch",
  "steps": [
   {
    "do": "tap",
    "target": "Build your own tool",
    "optional": true
   },
   {
    "do": "tap",
    "target": "Templates"
   },
   {
    "do": "tap",
    "target": "Run",
    "near": "Long text to 3 sentences"
   },
   {
    "do": "type",
    "target": "Your text",
    "text": "Tenzy helps people get everyday jobs done on their phone. It can shrink videos for email, strip location from photos, turn receipts into expense rows, and remind you before a return window closes. Everything runs on the phone, so nothing is uploaded. Users can also build their own tools by snapping steps together or by describing what they want in plain words. The app aims to be the one place people go when a phone task feels fiddly."
   },
   {
    "do": "tap",
    "target": "Run"
   },
   {
    "do": "wait",
    "seconds": 6
   }
  ],
  "expected": "A shorter summary is shown.",
  "checks": [
   {
    "oracle": "screen_changed"
   },
   {
    "oracle": "no_app_error_logged"
   }
  ],
  "severity": "medium"
 }
]