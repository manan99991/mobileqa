  "entry_screen": "launch",
  "steps": [
   {
    "do": "share_in",
    "kind": "text",
    "text": "Tenzy helps people get everyday jobs done on their phone. It can shrink videos for email, strip location from photos, and turn receipts into expense rows. Every tool shows a preview before saving. Results land where they are needed, like the share sheet or a spreadsheet. Nothing leaves the phone unless you share it. It works offline for most tools."
   },
   {
    "do": "tap",
    "target": "Run",
    "near": "Long text to 3 sentences"
   },
   {
    "do": "wait",
    "seconds": 10
   }
